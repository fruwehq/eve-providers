#!/usr/bin/env python3
"""Provider status must distinguish absent state from backend/API failures."""

from __future__ import annotations

import os
import shutil
import subprocess
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


class ProviderStatusErrors(unittest.TestCase):
    def setUp(self) -> None:
        self.temp = tempfile.TemporaryDirectory(prefix="eve-provider-status.")
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.bin = self.root / "bin"
        self.bin.mkdir()
        self.env = {"PATH": f"{self.bin}:{os.environ['PATH']}"}

    def executable(self, name: str, body: str) -> None:
        path = self.bin / name
        path.write_text("#!/usr/bin/env bash\n" + body + "\n")
        path.chmod(0o755)

    def state_probe(self) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            ["bash", "-c", '. "$1"; eve_tf_state_json test candidate', "probe",
             str(ROOT / "_common/lib/tf-state.sh")],
            cwd=self.root, env=self.env, capture_output=True, text=True,
        )

    def test_missing_explicit_state_is_absent_without_backend_access(self) -> None:
        self.env["EVE_TF_STATE_BASE"] = str(self.root / "state")
        self.executable("terramate", "echo unexpected-backend >&2; exit 42")
        result = self.state_probe()
        self.assertEqual(result.returncode, 0)
        self.assertEqual(result.stdout, "")
        self.assertEqual(result.stderr, "")

    def test_generation_failure_propagates(self) -> None:
        self.executable("terramate", "echo generation-failed >&2; exit 23")
        result = self.state_probe()
        self.assertEqual(result.returncode, 23)
        self.assertIn("generation-failed", result.stderr)

    def test_backend_failure_propagates(self) -> None:
        self.executable("terramate", 'if [ "$1" = generate ]; then exit 0; fi; echo access-denied >&2; exit 42')
        result = self.state_probe()
        self.assertEqual(result.returncode, 42)
        self.assertIn("access-denied", result.stderr)

    def test_invalid_backend_json_is_an_error(self) -> None:
        self.executable("terramate", 'if [ "$1" = generate ]; then exit 0; fi; echo invalid-json')
        result = self.state_probe()
        self.assertNotEqual(result.returncode, 0)
        self.assertIn("Cannot parse", result.stderr)

    def test_aws_api_error_is_not_reported_as_absence(self) -> None:
        subprocess.run(["git", "init", "-q", str(self.root)], check=True)
        commands = self.root / "aws/commands"
        shared = self.root / "_common/lib"
        scripts = self.root / "scripts"
        for path in [commands, shared, scripts]:
            path.mkdir(parents=True)
        shutil.copy2(ROOT / "aws/commands/status", commands / "status")
        shutil.copy2(ROOT / "_common/lib/tf-state.sh", shared / "tf-state.sh")
        (shared / "profile-env.sh").write_text(
            "eve_load_profile_env() { ENGINE=terraform; PROVIDER=aws; OS_FAMILY=ubuntu; TAGS=test; }\n"
        )
        (scripts / "tf-env").write_text("#!/usr/bin/env bash\nexit 0\n")
        (scripts / "tf-env").chmod(0o755)
        state = self.root / "state/plugins/providers/aws/stacks/20-services/default.tfstate"
        state.parent.mkdir(parents=True)
        state.write_text(
            '{"resources":[{"type":"aws_instance","name":"main",'
            '"instances":[{"attributes":{"id":"i-fake","instance_state":"running"}}]}]}'
        )
        self.env["EVE_TF_STATE_BASE"] = str(self.root / "state")
        self.executable("aws", "echo simulated-access-denied >&2; exit 42")
        result = subprocess.run(
            [str(commands / "status"), "test"], cwd=self.root,
            env=self.env, capture_output=True, text=True,
        )
        self.assertEqual(result.returncode, 42)
        self.assertIn("simulated-access-denied", result.stderr)
        self.assertNotIn("absent", result.stdout)


if __name__ == "__main__":
    unittest.main()
