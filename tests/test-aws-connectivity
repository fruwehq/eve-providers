#!/usr/bin/env python3
from __future__ import annotations

import importlib.machinery
import importlib.util
import io
import json
import os
import sys
import unittest
from contextlib import redirect_stdout
from pathlib import Path
from types import ModuleType
from unittest.mock import patch

ROOT = Path(__file__).resolve().parents[1]
sys.dont_write_bytecode = True


def load_command() -> ModuleType:
    path = ROOT / "aws" / "commands" / "connectivity"
    loader = importlib.machinery.SourceFileLoader("aws_connectivity", str(path))
    spec = importlib.util.spec_from_loader("aws_connectivity", loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class AwsConnectivityTests(unittest.TestCase):
    def run_probe(
        self, env: dict[str, str], *, cli: bool = True, returncode: int = 1
    ) -> dict[str, str]:
        module = load_command()
        output = io.StringIO()
        command_result = type("Result", (), {"returncode": returncode})()
        with (
            patch.dict(os.environ, env, clear=True),
            patch.object(module, "shutil") as shutil_mock,
            patch.object(module, "subprocess") as subprocess_mock,
            redirect_stdout(output),
        ):
            shutil_mock.which.return_value = "/usr/bin/aws" if cli else None
            subprocess_mock.DEVNULL = module._DEVNULL
            subprocess_mock.run.return_value = command_result
            module.main()
        parsed = json.loads(output.getvalue())
        self.assertIsInstance(parsed, dict)
        return parsed

    def test_cli_missing_is_unconfigured(self) -> None:
        result = self.run_probe({}, cli=False)
        self.assertEqual(result["configured"], "no")
        self.assertEqual(result["reachable"], "no")

    def test_complete_static_pair_is_configured(self) -> None:
        result = self.run_probe(
            {
                "AWS_ACCESS_KEY_ID": "access",
                "AWS_SECRET_ACCESS_KEY": "secret",
            }
        )
        self.assertEqual(result["configured"], "yes")
        self.assertEqual(result["reachable"], "no")

    def test_partial_static_pair_is_unconfigured(self) -> None:
        result = self.run_probe({"AWS_ACCESS_KEY_ID": "access"})
        self.assertEqual(result["configured"], "no")
        self.assertEqual(result["reachable"], "no")

    def test_profile_is_configured(self) -> None:
        result = self.run_probe({"AWS_PROFILE": "eve"})
        self.assertEqual(result["configured"], "yes")
        self.assertEqual(result["reachable"], "no")

    def test_successful_probe_is_reachable(self) -> None:
        result = self.run_probe({"AWS_PROFILE": "eve"}, returncode=0)
        self.assertEqual(result["configured"], "yes")
        self.assertEqual(result["reachable"], "yes")


if __name__ == "__main__":
    unittest.main()
