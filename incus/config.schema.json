{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incus provider configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_timeout",
    "config_dir",
    "endpoint",
    "image",
    "instance_prefix",
    "nic",
    "project",
    "public_key_file",
    "remote",
    "run_id",
    "ssh_private_key_file",
    "subnet"
  ],
  "properties": {
    "command_timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "config_dir": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://[^/@?#]+:[0-9]+$"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "instance_prefix": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,9}$"
    },
    "nic": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "project": {
      "const": "eve-ci"
    },
    "public_key_file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "remote": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$",
      "not": {
        "enum": [
          "images",
          "local"
        ]
      }
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ssh_private_key_file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "subnet": {
      "type": "string",
      "minLength": 1
    }
  }
}
