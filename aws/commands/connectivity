#!/usr/bin/env python3
"""AWS connectivity probe for providers-status."""
from __future__ import annotations

import json
import os
import shutil
import subprocess

_DEVNULL = subprocess.DEVNULL


def main() -> None:
    aws_profile = os.environ.get("AWS_PROFILE", "")
    if not aws_profile:
        print(json.dumps({"configured": "no", "reachable": "no",
                          "notes": "configure an explicit named AWS profile"}))
        return

    if shutil.which("aws") is None:
        print(json.dumps({"configured": "yes", "reachable": "no", "notes": "aws cli not found"}))
        return

    args = ["--profile", aws_profile, "sts", "get-caller-identity"]
    aws_region = os.environ.get("AWS_REGION", "")
    if aws_region:
        args = ["--region", aws_region, *args]

    if subprocess.run(["aws", *args], stdout=_DEVNULL, stderr=_DEVNULL, check=False).returncode == 0:
        print(json.dumps({"configured": "yes", "reachable": "yes", "notes": f"aws sts ok (profile {aws_profile})"}))
        return
    print(json.dumps({"configured": "yes", "reachable": "no",
                      "notes": "configured profile is unreachable; its login/SSO session may have expired - "
                               "run the AWS Login provider action"}))


if __name__ == "__main__":
    main()
